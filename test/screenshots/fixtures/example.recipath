                        }
                    ],
                    "minutes": null
                },
                {
                    "id": "MMWSQGplTgjLKlZV",
                    "description": "Add the tomato passata and season everything.",
                    "ingredients": [
                        {
                            "id": "A0727S3g3s797e9e",
                            "amount": 1500.0,
                            "unit": "Gram",
                            "groceryId": "12VfA5a0p33QMAS3",
                            "uploaded": true
                        },
                        {
                            "id": "486019079296845e",
                            "amount": 50.0,
                            "unit": "Gram",
                            "groceryId": "je66Cea7hZm1h1ui",
                            "uploaded": true
                        },
                        {
                            "id": "BNLM2hSTlxr8Pnhe",
                            "amount": 10.0,
                            "unit": "Gram",
                            "groceryId": "mVHGC0t7IQdZ2R0L",
                            "uploaded": true
                        },
                        {
                            "id": "HbYHFiTzTKRIJihM",
                            "amount": 10.0,
                            "unit": "Gram",
                            "groceryId": "EXx72oOAEr3pOQSW",
                            "uploaded": true
                        }
                    ],
                    "minutes": null
                },
                {
                    "id": "Vvd6nWz99y38aRsJ",
                    "description": "Let everything simmer until it thickens.",
                    "ingredients": [],
                    "minutes": null
                },
                {
                    "id": "tIower8qfhbyg50z",
