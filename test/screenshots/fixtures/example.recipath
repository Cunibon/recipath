        "3xiMVfMOXMgTgkY3": {
            "id": "3xiMVfMOXMgTgkY3",
            "parent": null,
            "title": "Chicken teriyaki",
            "servings": 2,
            "imageName": "Yn48AEPTKTU757R9",
            "steps": [
                {
                    "id": "3185682228n64052",
                    "description": "Start cooking rice",
                    "ingredients": [
                        {
                            "id": "534q78Do916qf545",
                            "amount": 200.0,
                            "unit": "Gram",
                            "groceryId": "GvLQBVC6ljl72FHD",
                            "uploaded": true
                        }
                    ],
                    "minutes": null
                },
                {
                    "id": "xDG059T02877X88p",
                    "description": "In a small mixing bowl (or liquid measuring cup) whisk together soy sauce, water, honey, brown sugar, rice vinegar, sesame oil, ginger, garlic and cornstarch.",
                    "ingredients": [
                        {
                            "id": "812Ny7IPEH75T04X",
                            "amount": 40.0,
