        "51181844xn138375": {
            "id": "51181844xn138375",
            "parent": null,
            "title": "Fried bananas",
            "servings": 20,
            "imageName": "9B5N6On35WUAZZE1",
            "steps": [
                {
                    "id": "QEYYVU88I37PPC12",
                    "description": "Put flour, baking powder, salt and sugar into a mixing bowl and combine. Add water and stir into a thick batter (the water can vary by 1-2 tbsp depending on the flour).",
                    "ingredients": [
                        {
                            "id": "Vd1497yJ33VGg381",
                            "amount": 80.0,
                            "unit": "Gram",
                            "groceryId": "3773648786a07325",
                            "uploaded": true
                        },
                        {
                            "id": "0033985661711140",
                            "amount": 0.5,
                            "unit": "Piece",
                            "groceryId": "8w7vi6o63pNd644s",
                            "uploaded": true
                        },
                        {
                            "id": "6LB3i030uBfra2fZ",
                            "amount": 1.0,
                            "unit": "Gram",
                            "groceryId": "je66Cea7hZm1h1ui",
                            "uploaded": true
                        },
                        {
                            "id": "EYYjKEG1BIDDWKJM",
                            "amount": 1.0,
                            "unit": "Tablespoon",
                            "groceryId": "1195uvBI6HLPTSpR",
                            "uploaded": true
                        },
                        {
                            "id": "U43tc9jp92eMhYle",
                            "amount": 8.0,
                            "unit": "Tablespoon",
                            "groceryId": "L3X13EZROLIX4VJZ",
                            "uploaded": true
                        }
                    ],
                    "minutes": null
                },
                {
                    "id": "61N6KU24FYhy6r13",
                    "description": "Cut the bananas into thick slices, dip them piece by piece into the batter and put them straight into a pan or deep fryer with hot oil. Fry for about 2 minutes until golden brown.",
                    "ingredients": [
                        {
                            "id": "e10458D0408U6941",
                            "amount": 2.0,
                            "unit": "Piece",
                            "groceryId": "4941219780l32531",
                            "uploaded": true
                        }
                    ],
                    "minutes": null
                },
                {
                    "id": "Xy4VQ49R4X93dHx7",
                    "description": "Let them drain briefly on kitchen paper, then plate, drizzle with honey and enjoy.",
                    "ingredients": [
                        {
                            "id": "1349125761y25386",
                            "amount": 10.0,
                            "unit": "Gram",
                            "groceryId": "391835139988s652",
                            "uploaded": true
                        }
                    ],
                    "minutes": null
                }
            ],
            "archived": false,
            "uploaded": true
        },
        "G1094418838291j3": {
            "id": "G1094418838291j3",
            "parent": "x7b485r4U5d2v4kz",
            "title": "Cottage Cheese Baked Ziti / Pasta",
            "servings": 6,
            "imageName": "N314G46G1SX0WA9X",
            "steps": [
                {
                    "id": "3b2T29w4R3rwdCgG",
                    "description": "Arrange a rack in upper third of oven; preheat to 210C.\n\nIn a large (at least 30cm), high-sided, ovenproof skillet over medium-high heat, heat oil. ",
                    "ingredients": [
                        {
                            "id": "2541Q255019993B9",
                            "amount": 2.0,
                            "unit": "Tablespoon",
                            "groceryId": "18633G1BA1517612",
                            "uploaded": true
                        }
                    ],
                    "minutes": null
                },
                {
                    "id": "1yz619Qjcn8v8l12",
                    "description": "Cook beef, breaking up into large pieces, until browned, 3 to 5 minutes. Stir in red pepper flakes (if using) and cook, stirring, until warmed through, about 1 minute.",
                    "ingredients": [
                        {
                            "id": "eCiov43177L4Y401",
                            "amount": 500.0,
                            "unit": "Gram",
                            "groceryId": "JYH08E6LIMNAQQNE",
                            "uploaded": true
                        }
                    ],
                    "minutes": null
                },
                {
                    "id": "h6jerxzuspV1cqwq",
                    "description": "Add marinara; season with 1 tsp. salt. Bring to a simmer and cook, stirring occasionally, until slightly thickened, about 10 minutes.",
                    "ingredients": [
                        {
                            "id": "452O0960X0803Z95",
                            "amount": 1200.0,
                            "unit": "Gram",
                            "groceryId": "ohptfaxdfcFafeon",
                            "uploaded": true
                        },
                        {
                            "id": "yIseovezbqLasurx",
                            "amount": 1.0,
                            "unit": "Teaspoon",
                            "groceryId": "je66Cea7hZm1h1ui",
                            "uploaded": true
                        }
                    ],
                    "minutes": 10
                },
                {
                    "id": "z36z1P1f3E703ci1",
                    "description": "Meanwhile, in a medium bowl, combine cottage cheese, garlic powder, half of Parmesan, and half of parsley, mashing the curds as you stir; season with salt and black pepper.",
                    "ingredients": [
                        {
                            "id": "3x2f971k349k1H7z",
                            "amount": 200.0,
                            "unit": "Gram",
                            "groceryId": "851C847779057837",
                            "uploaded": true
                        },
                        {
                            "id": "ig1bJbaW4zaC7Z05",
                            "amount": 30.0,
                            "unit": "Gram",
                            "groceryId": "xs9uhpapU4pIr44K",
                            "uploaded": true
                        },
                        {
                            "id": "323689306r40HNXj",
                            "amount": 5.0,
                            "unit": "Gram",
                            "groceryId": "PGWPFR5VJL3JU71u",
                            "uploaded": true
                        },
                        {
                            "id": "Wqe4CjJ4oi9362Gm",
                            "amount": 5.0,
                            "unit": "Gram",
                            "groceryId": "je66Cea7hZm1h1ui",
                            "uploaded": true
                        },
                        {
                            "id": "O0R94D1Q9X2LJvB4",
                            "amount": 5.0,
                            "unit": "Gram",
                            "groceryId": "mVHGC0t7IQdZ2R0L",
                            "uploaded": true
                        }
                    ],
                    "minutes": null
                },
                {
                    "id": "3178120210085251",
                    "description": "Add ziti and water to skillet and bring to a simmer. Cook, stirring so pasta doesn’t stick to bottom of skillet, until well combined, about 2 minutes. ",
                    "ingredients": [
                        {
                            "id": "1885e967027F3766",
                            "amount": 500.0,
                            "unit": "Gram",
                            "groceryId": "0RV4M6MA2HTW1JZ8",
                            "uploaded": true
                        },
                        {
                            "id": "NTJGIX2cLBUnMAY6",
                            "amount": 500.0,
                            "unit": "Milliliter",
                            "groceryId": "L3X13EZROLIX4VJZ",
                            "uploaded": true
                        }
                    ],
                    "minutes": null
                },
                {
                    "id": "u8KpxfQaGh3IC97U",
                    "description": "Remove skillet from heat, then fold in half of cottage cheese mixture and half of mozzarella, making sure to leave some pockets of cheese throughout.",
                    "ingredients": [
                        {
                            "id": "l582z2s45p9pm80h",
                            "amount": 125.0,
                            "unit": "Gram",
                            "groceryId": "08188l50628o8s0v",
                            "uploaded": true
                        }
                    ],
                    "minutes": null
                },
                {
                    "id": "88nzg79v44urjv08",
                    "description": "Dollop pasta with remaining cottage cheese mixture. Sprinkle remaining mozzarella and Parmesan over.",
                    "ingredients": [
                        {
                            "id": "494kx8o688Sh4751",
                            "amount": 125.0,
                            "unit": "Gram",
                            "groceryId": "08188l50628o8s0v",
                            "uploaded": true
                        },
                        {
                            "id": "avurEa29p3qNdUjc",
                            "amount": 30.0,
                            "unit": "Gram",
                            "groceryId": "xs9uhpapU4pIr44K",
                            "uploaded": true
                        }
                    ],
                    "minutes": null
                },
                {
                    "id": "L460KQIE28i9005u",
                    "description": "Transfer to oven and bake until pasta is tender and bubbling, and cheese is golden and browned in spots, 25 - 30 minutes. Let cool 5 minutes. Top with remaining parsley.",
                    "ingredients": [],
                    "minutes": 25
                }
            ],
            "archived": false,
            "uploaded": true
        },
