                            "uploaded": true
                        }
                    ],
                    "minutes": null
                },
                {
                    "id": "YPC6aK7xej4C3uN5",
                    "description": "Heat olive oil in a 12-inch non-stick skillet over medium-high heat.",
                    "ingredients": [
                        {
                            "id": "dku0nqBrw8os1Lbj",
                            "amount": 10.0,
                            "unit": "Milliliter",
                            "groceryId": "18633G1BA1517612",
                            "uploaded": true
                        }
                    ],
                    "minutes": null
                },
                {
                    "id": "ua1t02Tl9nr7r2i8",
                    "description": "Add in chicken and let brown on bottom.",
                    "ingredients": [
                        {
                            "id": "rUPjtlaBFRoTtCXE",
                            "amount": 400.0,
                            "unit": "Gram",
                            "groceryId": "7m70497d03062300",
                            "uploaded": true
                        }
                    ],
                    "minutes": null
                },
                {
                    "id": "BJRKLEMT1VCBP3DI",
                    "description": "Stir the sauce in with the cooked chicken and continue to cook and toss until sauce has thickened, about 30 - 60 seconds longer.",
                    "ingredients": [],
                    "minutes": null
                },
                {
                    "id": "E01D19N0U8405R13",
                    "description": "Serve warm garnished with green onions and sesame seeds if desired.",
                    "ingredients": [
