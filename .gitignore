# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

sentry.properties

# FVM Version Cache
.fvm/

# Apple signing & release artifacts — never commit
*.p12
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile
*.p8
ExportOptions.plist
*.ipa
*.xcarchive
*.dSYM
*.dSYM.zip
**/DerivedData/
**/xcuserdata/

# fastlane artifacts
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output/
fastlane/README.md
fastlane/.env*

# Secret-injection files (--dart-define-from-file)
.env
.env.*
!.env.example
env.json
dart_defines.json

# Android release signing (safety net; android/.gitignore covers in-dir)
key.properties
*.jks
*.keystore

# Gradle output under android/ (root /build/ does not cover it)
android/build/
android/app/build/

# Firebase configs (not currently used; safety net)
**/GoogleService-Info.plist
**/google-services.json
# Generated store screenshots (flutter test --update-goldens test/screenshots)
/metadata/
